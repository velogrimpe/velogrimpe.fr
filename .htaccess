RewriteEngine On
# Redirection canonique : vélogrimpe.fr (IDN -> punycode) vers velogrimpe.fr
# Couvre le domaine accentué et son www. Conserve le chemin et la query string.
RewriteCond %{HTTP_HOST} !^(velogrimpe\.fr|localhost:4000)$ [NC]
RewriteRule ^ https://velogrimpe.fr%{REQUEST_URI} [L,R=301]
# Force HTTPS (désactivé en dev et prod car hostinger le fait)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# Vielles URLs
RewriteRule ^ajout/admin/(.*)$ /admin/$1 [R=301,L]
RewriteRule ^admin/ajout_donnees_admin.php$ /admin/ [R=301,L]
# Feeds
RewriteRule ^feed/actualites\.xml$ /feed/actualites.php [L]
RewriteRule ^feed/nouveautes\.xml$ /feed/nouveautes.php [L]
# URLs conventionnelles -> flux Actualités (alias servis directement, sans redirection)
RewriteRule ^feed\.xml$ /feed/actualites.php [L]
RewriteRule ^(rss|feed)/?$ /feed/actualites.php [L]
RewriteRule ^actualites/([a-zA-Z0-9_-]+)$ /actualites/newsletter.php?slug=$1 [L,QSA]
RewriteRule ^p/([a-z0-9/-]+)/?$ /p/dispatch.php?slug=$1 [L,QSA]
# Sert les exports open data via download.php pour tracer chaque téléchargement.
# Réécriture INTERNE : l'URL publique reste .geojson (canonique). download.php
# lit le fichier sur disque (readfile), donc aucune boucle de réécriture.
RewriteRule ^open-data/(falaises|falaises-details|itineraires-velo|gares|complet)\.geojson$ /open-data/download.php?f=$1 [L,QSA]

# --- Point de montage des données (public -> ../public) -----------------------
# `public` est un lien symbolique versionné vers un dossier hors du dossier
# déployé : aucun déploiement ne peut effacer les contenus téléversés (images de
# falaises, GPX) ni les fichiers générés (GeoJSON de barres).
#
# Les deux garanties — aucun exécutable, aucun listing — sont posées ICI et pas
# seulement dans le .htaccess de la cible : derrière un lien symbolique dont la
# cible est hors DocumentRoot, un .htaccess enfant peut être ignoré selon la
# portée d'AllowOverride. Ce fichier-ci est toujours lu, et `[F,L]` est évalué
# avant l'autorisation — donc le `<Limit GET POST> Allow from all` (syntaxe 2.2)
# en fin de fichier ne peut pas le contredire via mod_access_compat.
#
# Le motif matche l'extension N'IMPORTE OÙ dans le nom, pas seulement en fin :
# sous une config à base d'`AddHandler`, Apache exécute `shell.php.jpg`, que le
# motif ancré `\.php$` de bdd/.htaccess laissait passer (cf. l'incident de
# juillet 2026, docs/incident-2026-07-29-compromission.md).
RewriteRule ^public/.*\.(php|phar|phtml|php[0-9]|phps|pht|inc|shtml|cgi|pl|py|rb|sh|lua)(\.|$) - [F,L,NC]

# Pas de listing du point de montage.
RewriteRule ^public/(.*/)?$ - [F,L]

# Résolution des URL de données vers le point de montage. Les fichiers vivent
# dans ~/public ; leurs URL publiques restent /bdd/… et /images/…, telles
# qu'elles sont stockées en base, publiées dans les exports open data et
# envoyées par mail. C'est cette règle qui fait le lien.
#
# Ordre : la règle [F] ci-dessus est AVANT celle-ci, et une réécriture interne
# relance le jeu de règles, donc /bdd/…/x.php est bloqué lui aussi. Pas de
# boucle : sur /public/bdd/… le motif ^(bdd|images)/ ne matche plus.
#
# La condition !-f sert aussi les assets versionnés restés dans le dossier
# déployé (logos, icônes de carte, styles) : ils sont trouvés sur place et la
# règle ne s'applique pas. Revers de la médaille, une DONNÉE qui traînerait au
# même chemin relatif masquerait sans erreur celle du point de montage — d'où
# la règle : dans bdd/, images/ et open-data/, rien qui ne soit versionné.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(bdd|images)/(.+)$ /public/$1/$2 [L]

ErrorDocument 404 /404.php

<FilesMatch ".*\.gpx$">
  # Les GPX sont des XML fournis par les contributeurs : attachment + nosniff
  # empêchent le navigateur de les rendre (XSS via xml-stylesheet / XHTML
  # embarqué) sur l'origine du site. N'affecte pas les fetch() de la carte.
  Header set Content-Disposition attachment
  Header set X-Content-Type-Options nosniff
  #Header set Content-Type application/gpx+xml
  ForceType application/gpx+xml
  Header set Cache-Control "max-age=31536000, public, must-revalidate"
</FilesMatch>

<FilesMatch ".*\.geojson$">
  # Force le bon Content-Type pour que la règle DEFLATE matche (sinon Apache
  # tombe sur text/plain ou octet-stream selon mime.types).
  ForceType application/geo+json
  Header set Cache-Control "max-age=31536000, public, must-revalidate"
</FilesMatch>

<FilesMatch ".*\.pmtiles$">
  # PMTiles = archives binaires lues par requêtes Range (HTTP Byte Serving).
  # Sans MIME connu, Apache les sert en text/plain → la règle DEFLATE (et la
  # compression du CDN Hostinger) gzippe la réponse : plus de Content-Length,
  # Range ignoré → erreur "no content-length header" côté pmtiles.js.
  # On force un type binaire et on désactive explicitement la compression.
  ForceType application/octet-stream
  SetEnv no-gzip 1
  SetEnv dont-vary 1
  Header set Cache-Control "max-age=86400, public, must-revalidate"
</FilesMatch>

<FilesMatch ".*\.(webp|png|jpg|jpeg)">
  Header set Cache-Control "max-age=31536000, public, must-revalidate"
</FilesMatch>

# Disable caching for JS files — sauf les bundles de build versionnés
# (cf. plus bas). Le négative-lookahead exclut map-{x.y.z}.js et map-maplibre-{x.y.z}.js
# pour qu'ils puissent être cachés long-terme.
<FilesMatch "^(?!map(?:-maplibre)?-\d[\d.A-Za-z-]*\.js$).+\.js$">
    FileETag None
    Header unset ETag
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Bundles de build versionnés (`map-1.9.4.js`, `map-maplibre-5.24.0.js`, etc.).
# Le filename change à chaque upgrade de lib → cache 1 an + immutable. PHP
# résout le filename courant via `dist/map-bundles.json` (cf. lib/map-bundle.php).
<FilesMatch "^map(?:-maplibre)?-\d[\d.A-Za-z-]*\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Compression gzip pour les assets bâtis (JS/CSS/JSON/SVG).
# Gain ~70% sur les bundles minifiés. No-op si mod_deflate n'est pas chargé.
# Note : Apache sert souvent le JS avec le MIME legacy `application/x-javascript`,
# on inclut donc les deux variantes.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/geo+json
  AddOutputFilterByType DEFLATE text/css text/javascript text/plain text/xml text/html
  AddOutputFilterByType DEFLATE image/svg+xml application/xml

</IfModule>

# Workaround pour le bug Apache + mod_deflate : mod_deflate ajoute "-gzip" à
# l'ETag dans la réponse mais ne strip pas le suffixe du If-None-Match entrant,
# donc le navigateur reçoit toujours 200 même quand rien n'a changé. On strip
# le suffixe côté requête pour réaligner. (DeflateAlterETag NoChange serait plus
# propre mais n'est pas autorisé dans ce .htaccess sur cette config Apache.)
<IfModule mod_headers.c>
  RequestHeader edit "If-None-Match" '^"(.*)-gzip"$' '"$1"'
</IfModule>

DirectoryIndex index.php
<Limit GET POST>
  Allow from all
</Limit>
# DO NOT REMOVE THIS LINE AND THE LINES BELOW IPALLOWID:bdy3fJPHzy
allow from 45.80.9.168
